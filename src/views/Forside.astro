---
// Forsiden (kapittel 5), delt mellom norsk (/) og engelsk (/en/).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrackLine from '../components/TrackLine.astro';
import Station from '../components/Station.astro';
import MaterialStrip from '../components/MaterialStrip.astro';
import Closing from '../components/Closing.astro';
import { hentEpoker } from '../lib/epoker';
import { ordbok, sprak } from '../i18n';

// Første stasjon teller opp fra dette året (det finnes ingen forrige epoke).
const START_AR = 1850;

const lang = sprak(Astro.currentLocale);
const t = ordbok(lang).forside;
const epoker = await hentEpoker(lang);
// Det første bildet etter overgangen til tunnel får «tunnellys» (5.4).
const forsteTunnel = epoker.findIndex(
  (e, i) => e.data.tema === 'tunnel' && epoker[i - 1]?.data.tema !== 'tunnel',
);
---

<Base tittel={t.tittel} beskrivelse={t.beskrivelse}>
  <Hero etikett={t.etikett} tittel={t.h1} ingress={t.ingress} />

  <TrackLine>
    {epoker.map((epoke, i) => (
      <Station
        epoke={epoke}
        fraAr={i === 0 ? START_AR : epoker[i - 1].data.ar}
        tunnellys={i === forsteTunnel}
      />
    ))}
  </TrackLine>

  <MaterialStrip />

  <Closing epoker={epoker} />
</Base>

<script>
  import { initMotion } from '../scripts/motion';

  initMotion();
</script>
