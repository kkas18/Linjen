---
// Epokeside (6.3): hero, lengre tekst, galleri og forrige/neste stasjon.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import FactBox from '../../components/FactBox.astro';
import Gallery from '../../components/Gallery.astro';
import { arTekst, hentEpoker, type Epoke } from '../../lib/epoker';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const epoker = await hentEpoker();
  return epoker.map((epoke, i) => ({
    params: { slug: epoke.data.slug },
    props: { epoke, forrige: epoker[i - 1], neste: epoker[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  epoke: Epoke;
  forrige?: Epoke;
  neste?: Epoke;
}

const { epoke, forrige, neste } = Astro.props;
const { data } = epoke;
const { Content } = await render(epoke);
---

<Base tittel={data.tittel} beskrivelse={data.ingress}>
  <Hero
    kompakt
    etikett={data.etikett}
    tittel={data.tittel}
    ingress={data.ingress}
    bilde={data.hovedbilde}
  />

  <article class="epoke ramme" data-tema={data.tema}>
    <div class="epoke__tekst">
      <Content />
    </div>

    {data.faktaruter.length > 0 && (
      <aside class="epoke__fakta" aria-label="Nøkkeltall">
        <FactBox fakta={data.faktaruter} />
      </aside>
    )}

    <section class="epoke__galleri" aria-labelledby="galleri-tittel">
      <h2 id="galleri-tittel">Bilder</h2>
      <Gallery bilder={data.galleri} />
    </section>

    <nav class="epoke__nav" aria-label="Stasjoner">
      {forrige ? (
        <a class="epoke__nav-lenke" href={url(`/epoker/${forrige.data.slug}/`)} rel="prev">
          <span class="t-etikett">
            <span aria-hidden="true">←</span> Forrige stasjon
          </span>
          <span class="epoke__nav-tittel">{forrige.data.tittel}</span>
          <span class="t-mono epoke__nav-ar">{arTekst(forrige.data)}</span>
        </a>
      ) : (
        <a class="epoke__nav-lenke" href={url('/')}>
          <span class="t-etikett">
            <span aria-hidden="true">←</span> Tilbake
          </span>
          <span class="epoke__nav-tittel">Hele linjen</span>
        </a>
      )}
      {neste && (
        <a
          class="epoke__nav-lenke epoke__nav-lenke--neste"
          href={url(`/epoker/${neste.data.slug}/`)}
          rel="next"
        >
          <span class="t-etikett">
            Neste stasjon <span aria-hidden="true">→</span>
          </span>
          <span class="epoke__nav-tittel">{neste.data.tittel}</span>
          <span class="t-mono epoke__nav-ar">{arTekst(neste.data)}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<script>
  import { initMotion } from '../../scripts/motion';

  initMotion();
</script>

<style>
  .epoke {
    display: grid;
    gap: var(--s-9);
    padding-block: var(--s-9) 0;
  }

  .epoke__tekst {
    display: grid;
    gap: var(--s-4);
    max-width: var(--tekst-maks);
  }

  .epoke__fakta {
    max-width: 40rem;
  }

  .epoke__galleri {
    display: grid;
    gap: var(--s-6);
  }

  .epoke__nav {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-7);
    border-top: var(--linje-tynn) solid var(--c-skinne);
  }

  .epoke__nav-lenke {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    background: var(--c-flate);
    color: var(--c-grafitt);
    text-decoration: none;
    border: var(--linje-tynn) solid var(--c-grafitt);
    transition:
      transform var(--t-rask) var(--ease-out),
      box-shadow var(--t-rask) var(--ease-out);
  }

  .epoke__nav-lenke:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .epoke__nav-lenke .t-etikett {
    color: var(--c-grafitt-2);
  }

  .epoke__nav-tittel {
    font-family: var(--f-serif);
    font-size: var(--fs-ingress);
    font-weight: 500;
  }

  .epoke__nav-ar {
    font-size: var(--fs-etikett);
    color: var(--c-grafitt-2);
  }

  @media (min-width: 48rem) {
    .epoke {
      padding-left: var(--stasjon-innrykk);
    }

    .epoke__nav {
      grid-template-columns: 1fr 1fr;
    }

    .epoke__nav-lenke--neste {
      grid-column: 2;
      text-align: right;
    }
  }
</style>
