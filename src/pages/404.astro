---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import { ordbok, rute } from '../i18n';

// GitHub Pages har én 404-side for hele nettstedet, så den er tospråklig.
const nb = ordbok('nb').feil;
const en = ordbok('en').feil;
---

<Base tittel={nb.tittel} beskrivelse={nb.beskrivelse} indekser={false}>
  <section class="feil ramme">
    <div class="feil__skilt">
      <Signal />
      <p class="t-etikett">{nb.etikett}</p>
    </div>
    <h1>{nb.h1}</h1>
    <p class="t-ingress">{nb.ingress}</p>
    <p>
      <a class="feil__lenke" href={rute('nb', 'forside')}>
        {nb.tilbake} <span aria-hidden="true">→</span>
      </a>
    </p>

    <div class="feil__en" lang="en">
      <p class="t-ingress">
        <strong>{en.h1}.</strong> {en.ingress}
      </p>
      <p>
        <a class="feil__lenke" href={rute('en', 'forside')}>
          {en.tilbake} <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .feil {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-9);
  }

  .feil__skilt {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .feil__en {
    display: grid;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: var(--linje-tynn) solid var(--c-skinne);
  }

  .feil__en strong {
    font-weight: 500;
  }

  .feil__lenke {
    color: var(--c-trikkebla);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .feil {
      padding-left: var(--stasjon-innrykk);
    }
  }
</style>
