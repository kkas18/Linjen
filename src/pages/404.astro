---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import { url } from '../lib/url';
---

<Base tittel="Feil spor" beskrivelse="Siden finnes ikke." indekser={false}>
  <section class="feil ramme">
    <div class="feil__skilt">
      <Signal />
      <p class="t-etikett">Feil spor · 404</p>
    </div>
    <h1>Denne siden finnes ikke</h1>
    <p class="t-ingress">
      Sporet du fulgte ender her. Gå tilbake til linjen og velg en ny stasjon.
    </p>
    <p>
      <a class="feil__lenke" href={url('/')}>
        Tilbake til forsiden <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</Base>

<style>
  .feil {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-9);
  }

  .feil__skilt {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .feil__lenke {
    color: var(--c-trikkebla);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .feil {
      padding-left: var(--stasjon-innrykk);
    }
  }
</style>
