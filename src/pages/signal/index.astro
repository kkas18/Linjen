---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TrackLine from '../../components/TrackLine.astro';
import Station from '../../components/Station.astro';
import SignalDemo from '../../components/SignalDemo.astro';

const stasjoner = (await getCollection('signal')).sort(
  (a, b) => a.data.rekkefolge - b.data.rekkefolge,
);
---

<Base
  tittel="Signal"
  beskrivelse="Signalanleggets historie – fra manuell drift og enkle signaler til reléstillverk, ATC og CBTC."
>
  <header class="side ramme">
    <p class="t-etikett side__etikett">Signalanleggets historie</p>
    <h1>Signal</h1>
    <p class="t-ingress">
      Fra tidlig manuell kjøring og enkle signaler, via reléstillverk og ATC, til dagens overgang
      til CBTC.
    </p>
  </header>

  <TrackLine>
    {stasjoner.map((s) => (
      <Station epoke={s} fraAr={null} lenke={null} />
    ))}
  </TrackLine>

  <div class="ramme demo-ramme">
    <SignalDemo />
  </div>
</Base>

<script>
  import { initMotion } from '../../scripts/motion';

  initMotion();
</script>

<style>
  .side {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-8) var(--s-5);
  }

  .side__etikett {
    color: var(--c-grafitt-2);
  }

  .demo-ramme {
    padding-block: var(--s-8) 0;
  }

  @media (min-width: 48rem) {
    .side,
    .demo-ramme {
      padding-left: var(--stasjon-innrykk);
    }
  }
</style>
