---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrackLine from '../components/TrackLine.astro';
import Station from '../components/Station.astro';

// Første stasjon teller opp fra dette året (det finnes ingen forrige epoke).
const START_AR = 1850;

const epoker = (await getCollection('epoker')).sort(
  (a, b) => a.data.rekkefolge - b.data.rekkefolge,
);
---

<Base
  tittel="Linjen"
  beskrivelse="Historien om hvordan hester, trikker og tog formet Oslo – fortalt stasjon for stasjon."
>
  <Hero
    etikett="Sporveien · 1875 – i dag"
    tittel="Linjen gjennom byen"
    ingress="Historien om hvordan hester, trikker og tog formet Oslo – fortalt stasjon for stasjon."
  />

  <TrackLine>
    {epoker.map((epoke, i) => (
      <Station epoke={epoke} fraAr={i === 0 ? START_AR : epoker[i - 1].data.ar} />
    ))}
  </TrackLine>
</Base>

<script>
  import { initMotion } from '../scripts/motion';

  initMotion();
</script>
