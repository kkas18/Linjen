---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/300.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/type.css';

import { pwaInfo } from 'virtual:pwa-info';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { TEMAFARGE } from '../../pwa.config.mjs';

interface Props {
  tittel: string;
  beskrivelse: string;
  ogBilde?: string; // sti under base, f.eks. 'og/hestesporveien.png'
  indekser?: boolean; // false = noindex (brukes av interne maler)
}

const { tittel, beskrivelse, ogBilde = 'og/forside.png', indekser = true } = Astro.props;
const fullTittel = tittel === 'Linjen' ? 'Linjen – Sporveiens historie' : `${tittel} · Linjen`;
const kanonisk = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(url(`/${ogBilde}`), Astro.site);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTittel}</title>
    <meta name="description" content={beskrivelse} />
    <link rel="canonical" href={kanonisk} />
    {!indekser && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={TEMAFARGE} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={fullTittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Setter starttilstand for animasjoner før første maling. Reserve: vis alt hvis motion.ts ikke starter.
      (function () {
        const rot = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          rot.dataset.motion = 'av';
          return;
        }
        rot.dataset.motion = 'på';
        setTimeout(function () {
          if (!rot.dataset.motionKlar) rot.dataset.motion = 'av';
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <a class="hopp-lenke" href="#innhold">
      Hopp til innhold
    </a>
    <Nav />
    <main id="innhold" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Offline-støtte (PWA): registrer service worker og oppdater automatisk.
      import { registerSW } from 'virtual:pwa-register';

      registerSW({ immediate: true });
    </script>
  </body>
</html>

<style>
  main {
    padding-top: var(--nav-hoyde);
  }

  main:focus {
    outline: none;
  }
</style>
