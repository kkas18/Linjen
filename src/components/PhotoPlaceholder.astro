---
// Grå flate som brukes når eiers bilde mangler (arbeidsregel 4).
interface Props {
  forhold?: string; // f.eks. '3 / 2'
  etikett?: string;
  tone?: 'lys' | 'mork'; // mørk brukes der lys tekst ligger over (hero)
  fyll?: boolean; // fyller forelderen i stedet for å bruke `forhold`
  class?: string;
}

const { forhold = '3 / 2', etikett, tone = 'lys', fyll = false, class: klasse } = Astro.props;
---

<div
  class:list={['plassholder', `plassholder--${tone}`, { 'plassholder--fyll': fyll }, klasse]}
  style={fyll ? undefined : `aspect-ratio: ${forhold}`}
  role="img"
  aria-label={etikett ?? 'Bilde kommer'}
>
  <span class="t-etikett">Bilde kommer</span>
</div>

<style>
  .plassholder {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--c-plassholder);
    color: var(--c-grafitt);
    border-radius: var(--r-bilde);
  }

  .plassholder--mork {
    background: var(--c-tunnel-2);
    color: var(--c-lys-tekst-2);
    border-radius: var(--r-ingen);
  }

  .plassholder--fyll {
    height: 100%;
  }
</style>
