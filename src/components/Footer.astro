---
import { url } from '../lib/url';
---

<footer class="bunn">
  <div class="bunn__indre ramme">
    <div>
      <p class="bunn__ordmerke">Linjen</p>
      <p class="t-bildetekst">Sporveiens historie 1875 – i dag</p>
    </div>
    <nav aria-label="Bunnmeny">
      <ul class="bunn__liste">
        <li>
          <a href={url('/kilder/')}>Kilder og bildekreditering</a>
        </li>
        <li>
          <a href={url('/om/')}>Om nettstedet</a>
        </li>
      </ul>
    </nav>
    <p class="bunn__merknad t-bildetekst">Ingen informasjonskapsler. Ingen sporing.</p>
  </div>
</footer>

<style>
  .bunn {
    margin-top: var(--s-9);
    border-top: var(--linje-tynn) solid var(--c-skinne);
    background: var(--c-perrong);
  }

  .bunn__indre {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-7);
  }

  .bunn__ordmerke {
    font-family: var(--f-serif);
    font-size: 1.375rem;
    font-weight: 500;
  }

  .bunn__liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .bunn__liste a {
    color: var(--c-grafitt-2);
  }

  .bunn__liste a:hover {
    color: var(--c-trikkebla);
  }

  @media (min-width: 48rem) {
    .bunn__indre {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .bunn__merknad {
      grid-column: 1 / -1;
    }
  }
</style>
