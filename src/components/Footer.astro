---
import { ordbok, rute, sprak } from '../i18n';

const lang = sprak(Astro.currentLocale);
const t = ordbok(lang).bunn;
---

<footer class="bunn">
  <div class="bunn__indre ramme">
    <div>
      <p class="bunn__ordmerke">Linjen</p>
      <p class="t-bildetekst">{t.undertittel}</p>
    </div>
    <nav aria-label={t.meny}>
      <ul class="bunn__liste">
        <li>
          <a href={rute(lang, 'kilder')}>{t.kilder}</a>
        </li>
        <li>
          <a href={rute(lang, 'om')}>{t.om}</a>
        </li>
      </ul>
    </nav>
    <p class="bunn__merknad t-bildetekst">{t.personvern}</p>
  </div>
</footer>

<style>
  .bunn {
    margin-top: var(--s-9);
    border-top: var(--linje-tynn) solid var(--c-skinne);
    background: var(--c-perrong);
  }

  .bunn__indre {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-7);
  }

  .bunn__ordmerke {
    font-family: var(--f-serif);
    font-size: 1.375rem;
    font-weight: 500;
  }

  .bunn__liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .bunn__liste a {
    color: var(--c-grafitt-2);
  }

  .bunn__liste a:hover {
    color: var(--c-trikkebla);
  }

  @media (min-width: 48rem) {
    .bunn__indre {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .bunn__merknad {
      grid-column: 1 / -1;
    }
  }
</style>
