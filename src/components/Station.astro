---
// Stasjon (5.2): én seksjon per epoke på forsiden.
import { Picture } from 'astro:assets';
import Signal from './Signal.astro';
import FactBox from './FactBox.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { url } from '../lib/url';
import { arHale, arTekst, utdrag, type Epoke } from '../lib/epoker';

interface Props {
  epoke: Epoke;
  fraAr: number | null; // året årstallet teller opp fra
  tunnellys?: boolean; // første T-banebilde får «tunnellys»-stripen (5.4)
}

const { epoke, fraAr, tunnellys = false } = Astro.props;
const { data } = epoke;
const tekst = utdrag(epoke.rendered?.html ?? '');
const hale = arHale(data);
const tekstVenstre = data.rekkefolge % 2 === 1;
const tittelId = `stasjon-${data.slug}`;
---

<section
  class:list={['stasjon', { 'stasjon--speilet': !tekstVenstre }]}
  id={data.slug}
  aria-labelledby={tittelId}
  data-stasjon
  data-tema={data.tema}
  data-navn={data.tittel}
  data-ar={data.ar ?? undefined}
  data-ar-tekst={arTekst(data)}
  data-fra={fraAr ?? undefined}
>
  <div class="stasjon__skilt-rad" data-stasjon-skilt-rad>
    <Signal class="stasjon__signal" />
    <p class="stasjon__skilt" data-stasjon-skilt>
      <span class="t-etikett">{data.tittel}</span>
      <span class="t-mono stasjon__skilt-ar">{arTekst(data)}</span>
    </p>
  </div>

  <p class="t-display stasjon__ar" aria-hidden="true">
    <span data-stasjon-ar>{data.ar ?? data.arVisning}</span>
    {hale && <span class="stasjon__ar-hale">{hale}</span>}
  </p>

  <div class="stasjon__tekst">
    <h2 id={tittelId}>{data.tittel}</h2>
    <p class="t-ingress stasjon__ingress">{data.ingress}</p>
    <div class="stasjon__brod" set:html={tekst} />
  </div>

  <figure class="stasjon__figur">
    <div class="stasjon__bilde" data-stasjon-bilde>
      <div class="stasjon__bilde-indre" data-stasjon-bilde-indre>
        {data.hovedbilde ? (
          <Picture
            src={data.hovedbilde.fil}
            alt={data.hovedbilde.alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 48rem) 55vw, 100vw"
            loading="lazy"
          />
        ) : (
          <PhotoPlaceholder forhold="4 / 3" />
        )}
      </div>
      {tunnellys && <span class="stasjon__tunnellys" aria-hidden="true" data-tunnellys />}
    </div>
    {data.hovedbilde ? (
      <figcaption class="t-bildetekst stasjon__bildetekst">
        {data.hovedbilde.bildetekst}
        <span class="stasjon__kreditering">
          {[data.hovedbilde.fotograf, data.hovedbilde.arkiv, data.hovedbilde.lisens]
            .filter(Boolean)
            .join(' · ')}
        </span>
      </figcaption>
    ) : (
      <figcaption class="t-bildetekst stasjon__bildetekst">
        [[TODO: hovedbilde med bildetekst og kreditering]]
      </figcaption>
    )}
  </figure>

  <div class="stasjon__fakta">
    <FactBox fakta={data.faktaruter} />
  </div>

  <p class="stasjon__lenke">
    <a href={url(`/epoker/${data.slug}/`)}>
      Les mer om epoken <span aria-hidden="true">→</span>
    </a>
  </p>
</section>

<style>
  .stasjon {
    position: relative;
    display: grid;
    grid-template-areas:
      'skilt'
      'ar'
      'tekst'
      'figur'
      'fakta'
      'lenke';
    row-gap: var(--s-5);
    padding: var(--s-9) var(--marg);
    color: var(--c-tekst);
  }

  /* Uten scroll-animasjon (redusert bevegelse / uten JS) er tunnelseksjonene mørke direkte.
     Med animasjon arver seksjonen fargene som motion.ts scrubber på linjeflaten. */
  :global(:root:not([data-motion='på'])) .stasjon[data-tema='tunnel'] {
    --c-bakgrunn: var(--c-tunnel);
    --c-tekst: var(--c-lys-tekst);
    --c-tekst-2: var(--c-lys-tekst-2);
    --c-spor: var(--c-skinne-mork);
    --c-lenke: var(--c-lys-tekst);
    /* Fullbredde-bakgrunn uten horisontal scroll */
    border-image: conic-gradient(var(--c-bakgrunn) 0 0) fill 0 / /0 100vw;
  }

  .stasjon__skilt-rad {
    grid-area: skilt;
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  /* Stasjonsskiltet er alltid hvitt med mørk tekst, også i tunnelen */
  .stasjon__skilt {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    background: var(--c-flate);
    color: var(--c-grafitt);
    border: var(--linje-tynn) solid var(--c-grafitt);
  }

  .stasjon__skilt-ar {
    font-size: var(--fs-etikett);
    font-weight: 300;
  }

  .stasjon__ar {
    grid-area: ar;
    color: var(--c-tekst);
  }

  .stasjon__ar-hale {
    font-size: var(--fs-h2);
    letter-spacing: 0;
  }

  .stasjon__tekst {
    grid-area: tekst;
    display: grid;
    gap: var(--s-5);
  }

  .stasjon__brod {
    display: grid;
    gap: var(--s-4);
  }

  .stasjon__figur {
    grid-area: figur;
    align-self: start;
    display: grid;
    gap: var(--s-3);
  }

  .stasjon__bilde {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-bilde);
  }

  .stasjon__bilde-indre {
    transform-origin: 50% 50%;
  }

  .stasjon__bilde :global(img) {
    width: 100%;
    filter: grayscale(1);
  }

  /* Smal lys stripe som feier én gang over det første T-banebildet */
  .stasjon__tunnellys {
    position: absolute;
    inset: 0 auto 0 0;
    width: 30%;
    background: var(--tunnellys-gradient);
    opacity: 0;
    pointer-events: none;
  }

  .stasjon__bildetekst {
    color: var(--c-tekst-2);
  }

  .stasjon__kreditering {
    display: block;
  }

  .stasjon__fakta {
    grid-area: fakta;
  }

  .stasjon__lenke {
    grid-area: lenke;
  }

  .stasjon__lenke a {
    color: var(--c-lenke);
    font-weight: 600;
    text-decoration: none;
    border-bottom: var(--linje-tynn) solid currentColor;
    padding-bottom: 2px;
  }

  .stasjon__lenke a:hover {
    border-bottom-width: var(--spor-bredde);
  }

  @media (min-width: 48rem) {
    .stasjon {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        'skilt skilt'
        'ar    ar'
        'tekst figur'
        'fakta figur'
        'lenke figur';
      grid-template-rows: auto auto auto auto 1fr;
      column-gap: var(--s-8);
      padding-left: var(--stasjon-innrykk);
    }

    .stasjon--speilet {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'skilt skilt'
        'ar    ar'
        'figur tekst'
        'figur fakta'
        'figur lenke';
    }

    /* Mørk skinne over SVG-linjen i tunnelseksjoner når fargene ikke scrubbes */
    :global(:root:not([data-motion='på'])) .stasjon[data-tema='tunnel']::before {
      content: '';
      position: absolute;
      inset: 0 auto 0 calc(var(--sporlinje-x) - var(--spor-bredde) / 2);
      width: var(--spor-bredde);
      background: var(--c-spor);
    }

    /* Signalet står ved sporlinjen, på høyde med stasjonsskiltet */
    .stasjon__skilt-rad {
      position: relative;
    }

    .stasjon__skilt-rad :global(.stasjon__signal) {
      position: absolute;
      left: calc(var(--sporlinje-x) + var(--s-3) - var(--stasjon-innrykk));
    }
  }
</style>
