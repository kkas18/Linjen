---
// Bildegalleri (6.3) som rutenett. Klikk åpner lysboksen.
import { Picture, getImage } from 'astro:assets';
import type { Stasjon } from '../lib/epoker';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import Lightbox, { type LysboksBilde } from './Lightbox.astro';
import { ordbok, sprak } from '../i18n';

interface Props {
  bilder: Stasjon['data']['galleri'];
  id?: string;
}

const { bilder, id = 'lysboks' } = Astro.props;
const lang = sprak(Astro.currentLocale);
const t = ordbok(lang);
const plassholdere = bilder.length === 0;

const kreditering = (b: (typeof bilder)[number]) =>
  [b.fotograf, b.arkiv, b.lisens].filter(Boolean).join(' · ');

// Stor versjon til lysboksen. Mangler bilder, vises plassholdere også i lysboksen.
const lysboks: LysboksBilde[] = plassholdere
  ? [1, 2, 3].map((n) => ({
      src: null,
      alt: `${t.felles.bildeKommer} (${n} / 3)`,
      bildetekst: t.felles.todoGalleribilde,
      kreditering: '',
    }))
  : await Promise.all(
      bilder.map(async (b) => ({
        src: (await getImage({ src: b.fil, width: 1600, format: 'webp' })).src,
        alt: b.alt,
        bildetekst: b.bildetekst ?? '',
        kreditering: kreditering(b),
      })),
    );
---

<ul class="galleri">
  {plassholdere
    ? lysboks.map((b, i) => (
        <li>
          <figure class="galleri__figur">
            <button
              class="galleri__knapp"
              type="button"
              aria-label={`${t.epoke.visStorre}: ${b.alt}`}
              data-lysboks-apne={i}
              data-lysboks-mal={id}
            >
              <PhotoPlaceholder forhold="4 / 3" />
            </button>
            <figcaption class="t-bildetekst">{b.bildetekst}</figcaption>
          </figure>
        </li>
      ))
    : bilder.map((b, i) => (
        <li>
          <figure class="galleri__figur">
            <button
              class="galleri__knapp"
              type="button"
              aria-label={`${t.epoke.visStorre}: ${b.alt}`}
              data-lysboks-apne={i}
              data-lysboks-mal={id}
            >
              <Picture
                src={b.fil}
                alt=""
                formats={['avif', 'webp']}
                widths={[400, 800, 1200]}
                sizes="(min-width: 48rem) 33vw, 100vw"
                loading="lazy"
                class="galleri__bilde"
              />
            </button>
            <figcaption class="t-bildetekst">
              {b.bildetekst}
              <span class="galleri__kreditering">{kreditering(b)}</span>
            </figcaption>
          </figure>
        </li>
      ))}
</ul>

<Lightbox id={id} bilder={lysboks} />

<style>
  .galleri {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-5);
    list-style: none;
    padding: 0;
  }

  .galleri__figur {
    display: grid;
    gap: var(--s-3);
  }

  .galleri__knapp {
    display: block;
    width: 100%;
    cursor: zoom-in;
    transition:
      transform var(--t-rask) var(--ease-out),
      box-shadow var(--t-rask) var(--ease-out);
  }

  .galleri__knapp:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .galleri__bilde {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1);
  }

  .galleri__kreditering {
    display: block;
  }
</style>
