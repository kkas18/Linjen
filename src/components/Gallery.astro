---
// Bildegalleri (6.3) som rutenett. Lysboks kommer i fase 3.
import { Picture } from 'astro:assets';
import type { Epoke } from '../lib/epoker';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  bilder: Epoke['data']['galleri'];
}

const { bilder } = Astro.props;
---

<ul class="galleri">
  {bilder.length > 0
    ? bilder.map((b) => (
        <li>
          <figure class="galleri__figur">
            <Picture
              src={b.fil}
              alt={b.alt}
              formats={['avif', 'webp']}
              widths={[400, 800, 1200]}
              sizes="(min-width: 48rem) 33vw, 100vw"
              loading="lazy"
              class="galleri__bilde"
            />
            <figcaption class="t-bildetekst">
              {b.bildetekst}
              <span class="galleri__kreditering">
                {[b.fotograf, b.arkiv, b.lisens].filter(Boolean).join(' · ')}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    : [1, 2, 3].map(() => (
        <li>
          <figure class="galleri__figur">
            <PhotoPlaceholder forhold="4 / 3" />
            <figcaption class="t-bildetekst">[[TODO: galleribilde med kreditering]]</figcaption>
          </figure>
        </li>
      ))}
</ul>

<style>
  .galleri {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-5);
    list-style: none;
    padding: 0;
  }

  .galleri__figur {
    display: grid;
    gap: var(--s-3);
  }

  .galleri__bilde {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1);
  }

  .galleri__kreditering {
    display: block;
  }
</style>
