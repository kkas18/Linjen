---
// Materiell-stripe (5.5): pinnet horisontal rad på desktop, vanlig sveip på mobil.
import MaterialCard from './MaterialCard.astro';
import { hentMateriell } from '../lib/epoker';
import { ordbok, sprak } from '../i18n';

const lang = sprak(Astro.currentLocale);
const t = ordbok(lang).materiell;
const vogner = await hentMateriell(lang);
---

<section class="materiell" aria-labelledby="materiell-tittel" data-materiell>
  <div class="materiell__hode ramme">
    <p class="t-etikett materiell__etikett">{t.etikett}</p>
    <h2 id="materiell-tittel">{t.stripeTittel}</h2>
  </div>
  <div
    class="materiell__vindu"
    tabindex="0"
    role="region"
    aria-label={t.stripeRegion}
    data-materiell-vindu
  >
    <ol class="materiell__rad" data-materiell-rad>
      {vogner.map((vogn) => (
        <MaterialCard vogn={vogn} />
      ))}
    </ol>
  </div>
</section>

<style>
  .materiell {
    padding-block: var(--s-9);
    background: var(--c-perrong);
    color: var(--c-grafitt);
    overflow: clip;
  }

  .materiell__hode {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-7);
  }

  .materiell__etikett {
    color: var(--c-grafitt-2);
  }

  /* Standard (mobil / redusert bevegelse): vanlig horisontal sveip med snapping */
  .materiell__vindu {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--marg);
    overscroll-behavior-x: contain;
  }

  .materiell__rad {
    display: flex;
    gap: var(--s-5);
    width: max-content;
    list-style: none;
    padding: var(--s-2) var(--marg) var(--s-5);
  }

  @media (min-width: 48rem) {
    .materiell__hode {
      padding-left: var(--stasjon-innrykk);
    }

    .materiell__rad {
      padding-left: max(
        var(--stasjon-innrykk),
        calc((100vw - var(--maks-bredde)) / 2 + var(--stasjon-innrykk))
      );
    }

    /* Pinnet: motion.ts flytter raden horisontalt mens seksjonen står fast */
    .materiell[data-pinnet='true'] .materiell__vindu {
      overflow: visible;
    }
  }
</style>
